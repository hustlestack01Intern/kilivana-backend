{
  "expo": {
    "name": "Kilivana",
    "slug": "kilivana",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#0F2E22" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.kilivana.app" },
    "android": {
      "package": "com.kilivana.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "extra": { "apiUrl": "http://localhost:8080" }
  }
}